DATABASE_URL=postgresql://postgres:change-me@localhost:5432/apply_ink
# Keep this small for serverless deployments; raise it only for a dedicated server.
DATABASE_POOL_MAX=10

# Optional in development: when omitted, Apply Ink creates a persistent random
# signing secret in PostgreSQL. Always set a strong random value in production.
AUTH_SECRET=

# Google OAuth web client credentials. The authorized redirect URI must be:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional scanned-PDF OCR fallback using keyless Vercel OIDC federation.
# These are separate from the Google sign-in client values above.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# eu keeps Vision OCR processing in the European Union. Also accepts us or global.
GCP_VISION_LOCATION=eu

JSEARCH_RAPIDAPI_KEY=

# Server-only shared key for job-specific CV rewriting.
# Never expose this value through NEXT_PUBLIC_* or commit a populated .env file.
OPENAI_API_KEY=
# Cost-sensitive default; override only with another Structured Outputs model.
OPENAI_RESUME_MODEL=gpt-5.6-luna

# JSON maps of employer board slug to employer-authorized credential.
# Example: {"company-board":"secret-from-that-company"}
GREENHOUSE_JOB_BOARD_API_KEYS={}
WORKABLE_ACCESS_TOKENS={}

# Used only by `npm run db:migrate:sqlite` when the old database is elsewhere.
APPLY_INK_DB_PATH=
