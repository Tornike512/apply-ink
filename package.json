{
  "name": "apply-ink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node scripts/check-postgres.mjs",
    "db:migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:test": "node --conditions react-server --import tsx scripts/test-postgres.ts",
    "auth:test": "node --conditions react-server --import tsx scripts/test-auth.ts",
    "google-auth:test": "node --conditions react-server --import tsx scripts/test-google-auth.ts",
    "onboarding-fields:test": "node --conditions react-server --import tsx scripts/test-onboarding-fields.ts",
    "public-pages:test": "node --import tsx scripts/test-public-pages.ts",
    "auth:api-test": "node --conditions react-server --import tsx scripts/test-auth-api.ts",
    "auth:registration-test": "node --conditions react-server --import tsx scripts/test-registration.ts",
    "job-filtering:test": "node --import tsx scripts/test-job-filtering.ts",
    "job-identity:test": "node --import tsx scripts/test-job-identity.ts",
    "resume-prefill:test": "node --conditions react-server --import tsx scripts/test-resume-prefill.ts",
    "resume-formats:test": "node --conditions react-server --import tsx scripts/test-resume-formats.ts",
    "job-sending:test": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local --conditions react-server --import tsx scripts/test-job-sending.ts",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "pre-push:test": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/pre-push.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.3",
    "google-auth-library": "^11.0.2",
    "next": "16.3.1",
    "officeparser": "^6.0.7",
    "openai": "^7.5.0",
    "pdfjs-dist": "5.5.207",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-international-phone": "^4.8.0",
    "server-only": "^0.0.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jszip": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "pdfjs-dist": "5.5.207"
  }
}
